# ==============================================================================
# Axon Configuration & Environment Variables
# ==============================================================================
# To configure Axon for your environment:
# 1. Copy this file: cp .env.example .env
# 2. Add your API key below.
# 3. Adjust optional parameters as desired.
#
# Axon automatically searches for .env in the current workspace, parent
# directories, ~/.axon/.env, and system environment variables.
# ==============================================================================

# ─── 1. Provider & Authentication (Required) ──────────────────────────────────
# Unified API key for AgentRouter, Anthropic, or OpenAI-compatible endpoints
AXON_API_KEY=your_api_key_here

# Base URL for API requests (default: https://agentrouter.org)
AXON_BASE_URL="https://agentrouter.org"

# ─── 2. Model & Reasoning Configuration ───────────────────────────────────────
# Active model identifier.
# Options: deepseek-v4-flash, gpt-5.6-sol, glm-5.3, claude-opus-5, claude-opus-4-8
AXON_MODEL="deepseek-v4-flash"

# Reasoning effort level:
# Options: reflex (fast/minimal), balanced (standard), synapse (high), quantum (maximum)
AXON_EFFORT="quantum"

# Enable/disable extended thinking and reasoning tokens (true / false)
AXON_THINKING=true

# ─── 3. Permissions & Security Mode ───────────────────────────────────────────
# Safety and permission mode:
# Options:
#   - default     : Prompt confirmation before bash execution & file writes
#   - acceptEdits : Auto-approve file writes; prompt for bash commands
#   - plan        : Read-only planning mode (mutations & bash disabled)
#   - bypass      : Auto-approve all tool actions (use with caution)
AXON_MODE="bypass"

# Dangerously skip all permission confirmation prompts (true / false)
AXON_DANGEROUSLY_SKIP_PERMISSIONS=false

# ─── 4. Token Budgets & Session Ceilings ──────────────────────────────────────
# Maximum reasoning + output tokens per single model turn
AXON_MAX_TOKENS=64000

# Maximum cumulative tokens across a multi-step turn
AXON_TURN_TOKEN_BUDGET=1000000

# Maximum tool loop iterations per turn before asking to continue
AXON_MAX_ITERATIONS=40

# Maximum cumulative dollar spend per session before halting
AXON_SESSION_COST_CEILING=10.00

# Memory compaction threshold ratio (0.0 to 1.0; 0.85 = compact at 85% context)
AXON_COMPACT_AT=0.85

# Sliding context window in turns (0 = unlimited history until compact threshold)
AXON_MAX_HISTORY_TURNS=0

# ─── 5. Tool & Subprocess Execution ───────────────────────────────────────────
# Subprocess timeout in seconds for Bash commands
AXON_BASH_TIMEOUT_S=120

# Maximum concurrent parallel read/fetch operations
AXON_PARALLEL_TOOLS=6

# Tool output character truncation limit
AXON_TOOL_OUTPUT_CAP=150000
