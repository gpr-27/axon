# ==============================================================================
# Axon environment file (example)
# ==============================================================================
# Copy to ~/.axon/.env (all projects) or <project>/.env (one project) and fill in
# what you use. Never commit the real file; .env is git-ignored.
#
# The easiest way to set this up is `axon setup`, which verifies the key and
# writes it for you.
# ==============================================================================

# Key for the default endpoint (AgentRouter) or whatever AXON_BASE_URL points at.
AXON_API_KEY="your_api_key_here"

# Optional: pick a provider preset, endpoint and model.
# AXON_PROVIDER="anthropic"
# AXON_BASE_URL="https://api.anthropic.com"
# AXON_MODEL="claude-sonnet-4-5"

# Per-provider keys. Axon uses the key that matches the provider of the model
# you select, so you can keep several here.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# GEMINI_API_KEY=""          # or GOOGLE_API_KEY
# DEEPSEEK_API_KEY=""
# XAI_API_KEY=""
# GROQ_API_KEY=""
# MISTRAL_API_KEY=""
# TOGETHER_API_KEY=""
# FIREWORKS_API_KEY=""
# CEREBRAS_API_KEY=""
# AZURE_OPENAI_API_KEY=""
# AGENTROUTER_API_KEY=""

# Local engines (Ollama, LM Studio) need no key:
# AXON_PROVIDER="ollama"
# AXON_BASE_URL="http://localhost:11434/v1"
