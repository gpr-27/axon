import { useState } from "react";

export function nextCount(count, step = 1) {
  return count + step;
}

export default function App() {
  const [count, setCount] = useState(0);
  return (
    <main className="app">
      <h1>{{title}}</h1>
      <button onClick={() => setCount((c) => nextCount(c))}>count is {count}</button>
      <p>
        Edit <code>src/App.jsx</code> and save to reload.
      </p>
    </main>
  );
}
