{
  "_comment": "Axon settings (Claude Code compatible). Copy to <project>/.axon/settings.json (shared with the team), <project>/.axon/settings.local.json (just you) or ~/.axon/settings.json (all projects). JSON has no comments, so explanations live in examples/README.md; keys starting with _ are ignored.",
  "model": "claude-sonnet-4-5",
  "smallModel": "claude-haiku-4-5",
  "effortLevel": "balanced",
  "trace_level": "normal",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(npm run *)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "WebFetch(domain:docs.python.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Edit(.git/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "budget": {
    "turn_usd": 1.0,
    "session_usd": 10.0,
    "action": "warn"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python .axon/hooks/block-dangerous-bash.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Patch",
        "hooks": [
          { "type": "command", "command": "python .axon/hooks/format-on-edit.py", "timeout": 60 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "git log --oneline -5", "timeout": 10 }
        ]
      }
    ]
  }
}
